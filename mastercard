      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Set seed for reproducibility\n",
        "np.random.seed(42)\n",
        "\n",
        "# Generate 1000 synthetic Mastercard transactions\n",
        "data_size = 1000\n",
        "data = {\n",
        "    'transactionID': range(1, data_size + 1),\n",
        "    'type': np.random.choice(['PAYMENT', 'TRANSFER', 'CASH_OUT', 'DEBIT'], data_size),\n",
        "    'amount': np.random.uniform(10, 5000, data_size),\n",
        "    'oldbalanceOrg': np.random.uniform(100, 100000, data_size),\n",
        "    'oldbalanceDest': np.random.uniform(0, 50000, data_size),\n",
        "    'isFraud': np.random.choice([0, 1], data_size, p=[0.95, 0.05]) # 5% fraud rate\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Apply your custom \"accountDiff\" logic from your previous experience\n",
        "df['accountDiff'] = abs(df['oldbalanceOrg'] - df['oldbalanceDest'])\n",
        "\n",
        "# Save to CSV\n",
        "df.to_csv('mastercard.csv', index=False)\n",
        "print(\"mastercard.csv created successfully!\")"
      ],
